# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/universal-file-toolkit

# Authentication
JWT_SECRET=supersecretjwtkey12345!@#
JWT_EXPIRES_IN=7d

# File Processing
TEMP_UPLOAD_DIR=uploads/temp
MAX_FILE_SIZE_MB=50

# Optional Local FFmpeg configuration
# FFmpeg is provided by the ffmpeg-static package and does not require a global installation.
# You may optionally override it if needed.
FFMPEG_PATH=
FFPROBE_PATH=
